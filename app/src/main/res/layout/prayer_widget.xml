<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wallpaper_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/glass_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/blur_overlay">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="المتبقي"
                android:textColor="#BFFFFFFF"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="1" />

            <TextView
                android:id="@+id/countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2 س 26 د"
                android:textColor="#FFFFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="19sp"
                android:autoSizeStepGranularity="1sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <ImageView
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:background="#55FFFFFF"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/next_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الصلاة القادمة"
                android:textColor="#BFFFFFFF"
                android:textSize="11sp"
                android:gravity="center"
                android:maxLines="1" />

            <TextView
                android:id="@+id/next_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeStepGranularity="1sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مواقيت الصلاة"
                android:textColor="#99FFFFFF"
                android:textSize="9sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="3dp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
