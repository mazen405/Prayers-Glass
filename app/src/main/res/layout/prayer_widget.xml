<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wallpaper_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/glass_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:background="@drawable/blur_overlay">

        <TextView
            android:id="@+id/location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مواقيت الصلاة"
            android:textColor="#DFFFFFFF"
            android:textSize="11sp"
            android:gravity="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/next_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الصلاة القادمة"
            android:textColor="#DFFFFFFF"
            android:textSize="13sp"
            android:gravity="end"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/next_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الظهر"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="end"
            android:includeFontPadding="false"
            android:layout_marginTop="1dp" />

        <TextView
            android:id="@+id/countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="متبقي ساعة و 20 دقيقة"
            android:textColor="#A9F5EE"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginTop="6dp" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#55FFFFFF"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مواقيت اليوم"
            android:textColor="#EFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginTop="9dp" />

        <TextView
            android:id="@+id/times"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الفجر 05:32  •  الظهر 12:40  •  العصر 15:55\nالمغرب 18:21  •  العشاء 19:38"
            android:textColor="#F5FFFFFF"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp"
            android:gravity="end"
            android:layout_marginTop="5dp" />

    </LinearLayout>
</FrameLayout>