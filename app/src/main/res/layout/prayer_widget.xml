<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wallpaper_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/glass_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp"
        android:background="@drawable/glass_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PRAYER TIMES"
                android:textColor="#BFFFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مواقيت الصلاة"
                android:textColor="#EFFFFFFF"
                android:textSize="11sp"
                android:gravity="end"
                android:maxLines="1" />
        </LinearLayout>

        <View
            android:layout_width="34dp"
            android:layout_height="3dp"
            android:layout_marginTop="14dp"
            android:background="#91F1E8" />

        <TextView
            android:id="@+id/next_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الصلاة القادمة"
            android:textColor="#D8FFFFFF"
            android:textSize="14sp"
            android:gravity="start"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/next_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الظهر"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:gravity="start"
            android:includeFontPadding="false"
            android:layout_marginTop="1dp" />

        <TextView
            android:id="@+id/countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="متبقي 1 ساعة و 20 دقيقة"
            android:textColor="#A9F5EE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="start"
            android:layout_marginTop="7dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="#45FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مواقيت اليوم"
            android:textColor="#D8FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="start"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/times"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الفجر 05:32  •  الظهر 12:40  •  العصر 15:55\nالمغرب 18:21  •  العشاء 19:38"
            android:textColor="#F5FFFFFF"
            android:textSize="12sp"
            android:lineSpacingExtra="5dp"
            android:gravity="start"
            android:layout_marginTop="7dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="يتجدد تلقائياً حسب مواقيت موقعك"
            android:textColor="#AFFFFFFF"
            android:textSize="10sp"
            android:gravity="start"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</FrameLayout>